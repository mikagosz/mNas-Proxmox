    "%@ zostanie przywrócony z kopii %@. Wszystko, co zmieniło się w nim po kopii, przepadnie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be restored from backup %@. Anything that changed in it after the backup will be lost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostanie przywrócony z kopii %@. Wszystko, co zmieniło się w nim po kopii, przepadnie."
          }
        }
      }
    },
    "%@ zostanie uruchomiony ponownie — wszystkie jego usługi znikną na kilkanaście sekund. Nie w trakcie kopii zapasowej (narzędzie to sprawdza).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be restarted — all its services will be gone for a dozen or so seconds. Not during a backup (the tool checks for that)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostanie uruchomiony ponownie — wszystkie jego usługi znikną na kilkanaście sekund. Nie w trakcie kopii zapasowej (narzędzie to sprawdza)."
