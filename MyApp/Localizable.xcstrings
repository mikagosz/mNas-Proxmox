    "Zatrzymaj (shutdown)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop (shutdown)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj (shutdown)"
          }
        }
      }
    },
    "Zatrzymają się wszystkie kontenery i usługi na serwerze. Serwer wróci po ok. 2–3 minutach, a mNas połączy się sam. Restart nie ruszy, gdy trwa kopia zapasowa albo aktualizacja.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All containers and services on the server will stop. The server will be back in about 2–3 minutes and mNas will reconnect by itself. The restart won't start while a backup or an update is running."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymają się wszystkie kontenery i usługi na serwerze. Serwer wróci po ok. 2–3 minutach, a mNas połączy się sam. Restart nie ruszy, gdy trwa kopia zapasowa albo aktualizacja."
          }
        }
      }
    },
