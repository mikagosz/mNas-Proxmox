{
  "sourceLanguage": "pl",
  "strings": {
    "\n\n→ mNas zakłada logowanie jako root. Sprawdź część przed „@\" w polu tokenu i klucz w /root/.ssh/authorized_keys.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n→ mNas assumes it logs in as root. Check the part before “@” in the token field and the key in /root/.ssh/authorized_keys."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n→ mNas zakłada logowanie jako root. Sprawdź część przed „@\" w polu tokenu i klucz w /root/.ssh/authorized_keys."
          }
        }
      }
    },
    " (podniesione z %lld do progu minimalnego)": {
