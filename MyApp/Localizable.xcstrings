    "%lld pozycji · %lld strony do przewijania strzałkami. Pozycja „Całe” zajmuje stronę sama, dwie „Pół” dzielą ją między siebie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items: %1$lld · pages: %2$lld (flip with the arrows). A “Full” item takes a page on its own, two “Half” items share one."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje: %1$lld · strony: %2$lld (przewijane strzałkami). Pozycja „Całe” zajmuje stronę sama, dwie „Pół” dzielą ją między siebie."
          }
        }
      }
    },
