          }
        }
      }
    },
    "Kopie chodzą zwykle w nocy, gdy Mac śpi — wtedy ten kafel nie powiadomi o błędzie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups usually run at night while the Mac sleeps — this tile cannot alert you then."
          }
        },
