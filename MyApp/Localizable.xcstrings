    "Kopia kontenerów": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Container backup"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia kontenerów"
          }
        }
      }
    },
    "Kopia przed aktualizacją: na dyskach ZFS, LVM-thin i Ceph narzędzie robi snapshot. Na zwykłym katalogu robi kopię vzdump na storage z **BACKUP_STORAGE** — wpisz taki, na którym jest miejsce na cały kontener:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup before updating: on ZFS, LVM-thin and Ceph the tool takes a snapshot. On a plain directory it makes a vzdump backup to the storage in **BACKUP_STORAGE** — enter one with room for the whole container:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia przed aktualizacją: na dyskach ZFS, LVM-thin i Ceph narzędzie robi snapshot. Na zwykłym katalogu robi kopię vzdump na storage z **BACKUP_STORAGE** — wpisz taki, na którym jest miejsce na cały kontener:"
          }
        }
      }
    },
    "Kopia zapasowa": {
      "localizations": {
