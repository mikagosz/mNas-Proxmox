    "Certyfikat serwera się zmienił. Jeśli nie był wymieniany celowo, ktoś podszywa się pod serwer — połączenie zostało przerwane.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server certificate has changed. If it was not replaced on purpose, someone is impersonating the server — the connection has been stopped."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Certyfikat serwera się zmienił. Jeśli nie był wymieniany celowo, ktoś podszywa się pod serwer — połączenie zostało przerwane."
          }
