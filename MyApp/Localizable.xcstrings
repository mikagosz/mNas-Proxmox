    },
    "%@ wróci do snapshotu %@ sprzed aktualizacji. Kontener zostanie na chwilę zatrzymany i uruchomiony ponownie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will return to snapshot %@ taken before the update. The container will be stopped briefly and started again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wróci do snapshotu %@ sprzed aktualizacji. Kontener zostanie na chwilę zatrzymany i uruchomiony ponownie."
          }
        }
      }
    },
