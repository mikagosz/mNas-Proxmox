    },
    "%@ na serwerze. Klienci korzystający z tej usługi (udziały, sesje) stracą połączenie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on the server. Clients using this service (shares, sessions) will lose their connection."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na serwerze. Klienci korzystający z tej usługi (udziały, sesje) stracą połączenie."
          }
        }
      }
    },
    "%@ usługę %@?": {
      "localizations": {
        "en": {
          "stringUnit": {
