          }
        }
      }
    },
    "Kliknij kafel **Aktualizacje**, potem **Zainstaluj narzędzie na serwerze…** i **Zainstaluj**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the **Updates** tile, then **Install the tool on the server…** and **Install**."
